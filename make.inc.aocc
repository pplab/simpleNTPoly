CC=mpicc
CXX=mpicxx
FC=mpif90

CXXFLAGS=-std=gnu++14 -O2 -g -fopenmp
FORTRAN_LIB=-lflang -lflangrti -lpgmath

OPENMPI_F_LIB=-lmpi_mpifh

BLAS_LIB=-lblis
LAPACK_LIB=-lflame
SCALAPACK_LIB=-lscalapack
MATH_LIB=-lalm -lamdlibm -laoclutils -lm

NTPOLY_DIR=/opt/NTPoly/3.1.1/openmpi-aocc-aocl
NTPOLY_INC=${NTPOLY_DIR}/include
NTPOLY_LIB=-L${NTPOLY_DIR}/lib -lNTPolyCPP -lNTPolyWrapper -lNTPoly
